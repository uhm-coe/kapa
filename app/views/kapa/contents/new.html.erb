<% content_for(:box1) do %>
  <h4 class="section-header">
    <%=link_to "",  {:action => :index}, :class => "glyphicon glyphicon-chevron-left" %>
    New Content
  </h4>

  <%# Templates the app's code looks up are registered by code (Kapa::Content.registry);
      staff pick one that doesn't have a template yet. %>
  <% used_codes = Kapa::Content.where.not(:code => nil).pluck(:code) %>
  <% email_codes = Kapa::Content.registry("email").reject { |code, _| used_codes.include?(code) } %>
  <% letter_registry = Kapa::Content.registry("letter") %>
  <% letter_codes = letter_registry.reject { |code, _| used_codes.include?(code) } %>

  <div class="row">
    <div class="col-sm-8">
    <%=bootstrap_form_for :content, :url => kapa_contents_path do |f| %>
      <%=f.select :type, [["Letter (PDF)", ""], ["Email", "email"]], {:label => "Type"}, :id => "content_type" %>
      <%=f.text_field :title %>
      <div class="type-fields" data-type="">
        <% if letter_codes.any? %>
          <%=f.select :code, letter_codes.map { |code, config| [config[:title], code] }, {:label => "Letter", :include_blank => true}, :id => "content_letter_code" %>
        <% elsif letter_registry.any? %>
          <p class="help-block">Every letter already has a template. Edit the existing one instead.</p>
        <% end %>
      </div>
      <div class="type-fields" data-type="email">
        <% if email_codes.any? %>
          <%=f.select :code, email_codes.map { |code, config| [config[:title], code] }, {:label => "Email", :include_blank => true}, :id => "content_email_code" %>
        <% else %>
          <p class="help-block">Every email already has a template. Edit the existing one instead.</p>
        <% end %>
        <%=f.text_field :subject %>
      </div>
      <%=render :partial => "/kapa/layouts/controls" if update? %>
    <% end %>
    </div>
  </div>

  <script>
    jQuery(function ($) {
      // Show the fields for the chosen type; disable the others so only one code is submitted.
      function showTypeFields() {
        var type = $("#content_type").val();
        $(".type-fields").each(function () {
          var active = $(this).data("type") === type;
          $(this).toggle(active).find("input, select").prop("disabled", !active);
        });
      }
      $("#content_type").on("change", showTypeFields);
      showTypeFields();
    });
  </script>
<% end %>
