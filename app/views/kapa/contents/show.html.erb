<% content_for(:head) do %>

  <%= stylesheet_link_tag "kapa/editor" %>
  <%= javascript_include_tag "kapa/editor" %>

<% end %>

<% content_for(:box1) do %>

  <h4 class="section-header">
    <%=link_to "", {:action => :index}, :class => "glyphicon glyphicon-chevron-left" %>
    <%=@content.title %>
  </h4>

  <%=bootstrap_form_for :content, :url => kapa_content_path(:id => @content), :html => {:method => :put, :id => "content_form"} do |f| %>
    <% config = @content.template_config %>
    <%=f.static :code, :label => (@content.email? ? "Email" : "PDF"), :content => @content.code %>
    <% if @content.email? %>
      <%=f.text_field :subject, :hint => "Liquid, like the body: e.g. {{ first_name }}" %>
    <% else %>
      <%=f.text_field :subject, :label => "File name", :hint => "Name of the generated PDF (Liquid, like the body), e.g. Admission Letter {{ term_desc }}. Blank uses the title." %>
    <% end %>
    <%=f.text_area :body, :class => "editor", :tooltip => "Find: Ctrl+F (⌘F on Mac). Replace: Ctrl+H (⌘⌥F on Mac)." %>
    <% if config[:variables].present? %>
      <div class="form-group">
        <label class="control-label">Available variables</label>
        <table class="table table-condensed">
          <% config[:variables].each do |name, description| %>
            <tr><td><code>{{ <%= name %> }}</code></td><td><%= description %></td></tr>
          <% end %>
        </table>
        <p class="help-block">
          <% if @content.email? %>
            Use <code>| escape</code> for names, e.g. <code>{{ first_name | escape }}</code>. If this template is inactive, this email is not sent.
          <% else %>
            If this template is inactive, this PDF can't be generated.
          <% end %>
        </p>
      </div>
    <% end %>
    <% if @content.email? %>
      <%=f.text_field :template_path, :label => "Layout Path", :hint => "Mail layout used for this email, e.g. student_mail (app/views/layouts/student_mail). Blank sends the email without a layout." %>
    <% else %>
      <%=f.text_field :template_path, :label => "Layout Path" %>
    <% end %>
    <%=f.select :active, [["Active", "1"], ["In-Active", "0"]] %>
    <%=f.property_select :depts, {:name => :dept, :label => t(:kapa_global_dept).pluralize}, {:multiple => true} %>
    <%=render(:layout => "/kapa/layouts/controls") do %>
      <li><%=link_to "Preview", {:action => :preview, :id => @content}, :target => :blank %></li>
    <% end if update?%>
  <% end %>

<% end %>
